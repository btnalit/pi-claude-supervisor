# Copy to ~/.config/pi-claude-supervisor/env (mode 0600), not into a public repository.
PI_CLAUDE_SUPERVISOR_MODE=auto
# Pi may be Bun-compiled; set this only when node is not on the Supervisor PATH.
# PI_CLAUDE_SUPERVISOR_NODE=/path/to/node
# Production should use required; off is only for environments with an explicitly verified process boundary.
# PI_CLAUDE_SUPERVISOR_CGROUP_MODE=required
# required cgroup mode is rejected with tmux; use auto/off for the tmux transport.
# PI_CLAUDE_SUPERVISOR_TRANSPORT=tmux
# PI_CLAUDE_SUPERVISOR_TMUX_SOCKET=/path/to/tmux.sock
# interactive (default): the real Claude TUI, driven by Claude Code hooks; run
# /supervise install-hooks once. bridge: the older stream-json-in-a-pane transport.
# PI_CLAUDE_SUPERVISOR_TMUX_MODE=interactive
# Interactive tmux mode only: exit the Worker and close its tmux session once a
# task completes; default keeps the session open for the operator to review.
# PI_CLAUDE_SUPERVISOR_CLOSE_WORKER_ON_COMPLETION=0
# PI_CLAUDE_SUPERVISOR_CWD_LEASE_DIR=/path/shared-by-all-pi-processes/cwd-leases
PI_CLAUDE_SUPERVISOR_HUMAN_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=REPLACE_ME
PI_CLAUDE_SUPERVISOR_HUMAN_WEBHOOK_FORMAT=wecom
# PI_CLAUDE_SUPERVISOR_HUMAN_WEBHOOK_SECRET=optional-shared-secret
# Total independent Reviewer budget per round, in ms (30000-3600000).
# PI_CLAUDE_SUPERVISOR_REVIEW_TIMEOUT_MS=600000
# Rotate events.jsonl at this size, in bytes; 5 rotated files are kept.
# PI_CLAUDE_SUPERVISOR_EVENT_LOG_MAX_BYTES=67108864
# policy | hybrid (default) | decision-worker; hybrid answers routine permissions without a Decision Worker call.
# PI_CLAUDE_SUPERVISOR_PERMISSION_AUTHORITY=hybrid
# --model for the Claude Worker; the operator's main cost lever (roughly 5x between Opus- and Sonnet-class models).
# PI_CLAUDE_SUPERVISOR_WORKER_MODEL=sonnet
# --autocompact tokens for the Claude Worker, bounding context per turn; 0 keeps Claude's own default.
# PI_CLAUDE_SUPERVISOR_WORKER_AUTOCOMPACT_TOKENS=200000
# --max-budget-usd for the Claude Worker; a hard cap, not a saving.
# PI_CLAUDE_SUPERVISOR_WORKER_MAX_BUDGET_USD=20
# --strict-mcp-config --mcp-config; only these MCP servers reach the Worker.
# PI_CLAUDE_SUPERVISOR_WORKER_MCP_CONFIG=/path/to/mcp.json
# Pi model for the Decision Worker, as provider/model-id (format Pi lists); undefined keeps Pi's configured default.
# PI_CLAUDE_SUPERVISOR_DECISION_MODEL=anthropic/claude-haiku-4-5-20251001
# Pi model for the independent Reviewer, as provider/model-id; undefined keeps Pi's configured default.
# PI_CLAUDE_SUPERVISOR_REVIEWER_MODEL=
# Proactively compact the persistent Decision Worker session past this estimated token count; 0 disables it.
# PI_CLAUDE_SUPERVISOR_DECISION_COMPACT_TOKENS=60000
# Minimum interval between repeated progress notifications for the same phase, in ms.
# PI_CLAUDE_SUPERVISOR_PROGRESS_HEARTBEAT_MS=60000
# Prune closed Decision Worker session records older than this many days on startup; 0 disables pruning.
# PI_CLAUDE_SUPERVISOR_DECISION_SESSION_RETENTION_DAYS=30
# Maximum bytes of repository evidence collected per task.
# PI_CLAUDE_SUPERVISOR_EVIDENCE_MAX_BYTES=1048576
# Maximum number of untracked files collected as repository evidence per task.
# PI_CLAUDE_SUPERVISOR_EVIDENCE_MAX_UNTRACKED_FILES=512
# Interactive tmux mode installs the Claude Code hook relay into ~/.claude/settings.json automatically (needed to adopt running sessions); set 0 to manage it with /supervise install-hooks yourself.
# PI_CLAUDE_SUPERVISOR_AUTO_INSTALL_HOOKS=1
# Cumulative wall-clock budget per task (8h, 90m, 2h30m or ms; 5m-7d); 0 disables it. /supervise start --deadline <duration> overrides it per task.
# PI_CLAUDE_SUPERVISOR_DEADLINE_MS=4h
# Close-out window after the deadline: an idle Worker is verified instead of stopped, then the Worker is stopped outright; 0 restores the immediate stop.
# PI_CLAUDE_SUPERVISOR_DEADLINE_GRACE_MS=30m
# How long before the deadline the Decision Worker is warned and asked to steer the Worker to a wrap-up; 0 disables the warning.
# PI_CLAUDE_SUPERVISOR_DEADLINE_WARNING_MS=15m
# Stop a Worker that produced no output for this long; 0 disables the check.
# PI_CLAUDE_SUPERVISOR_NO_OUTPUT_TIMEOUT_MS=20m
# Remote authority for the publish phase, granted only after acceptance and the Reviewer pass: none (default), push, or pr.
# PI_CLAUDE_SUPERVISOR_REMOTE_AUTHORITY=none
# The single remote a publish grant may name.
# PI_CLAUDE_SUPERVISOR_REMOTE_NAME=origin
