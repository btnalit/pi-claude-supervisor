# Copy to ~/.config/pi-claude-supervisor/env (mode 0600), not into a public repository.
PI_CLAUDE_SUPERVISOR_MODE=auto
PI_CLAUDE_SUPERVISOR_HUMAN_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=REPLACE_ME
PI_CLAUDE_SUPERVISOR_HUMAN_WEBHOOK_FORMAT=wecom
